# Paths to local repos used as Docker build contexts.
# These are relative to this directory by default.
CAFE_CAR_DIR=../cafe-car
SCHEDULE_FOAMER_DIR=../schedule-foamer
VEHICLE_POSER_DIR=../vehicle-poser
TRIP_UPDOGGER_DIR=../trip-updogger
HELL_GATE_BRIDGE_DIR=../hell-gate-bridge

# Not a build context: the yard-master SPA is bind-mounted from its dist/, so
# `pnpm build` must have run in that checkout before the stack starts.
YARD_MASTER_DIR=../yard-master

# Optional: uncomment and set to a registry image to skip building locally.
# The git.kcfam.us packages are public, so no docker login is needed.
#
# CI publishes :latest and :<short-sha> only. There is no :main tag. To
# reproduce exactly what prod is running, read the digests out of
# deploy-gtfs-rt (gtfs/*.yaml) and pin the short sha here rather than :latest.
# CAFE_CAR_IMAGE=git.kcfam.us/gtfs.zone/cafe-car:latest
# SCHEDULE_FOAMER_IMAGE=git.kcfam.us/gtfs.zone/schedule-foamer:latest
# VEHICLE_POSER_IMAGE=git.kcfam.us/gtfs.zone/vehicle-poser:latest
# TRIP_UPDOGGER_IMAGE=git.kcfam.us/gtfs.zone/trip-updogger:latest
# HELL_GATE_BRIDGE_IMAGE=git.kcfam.us/gtfs.zone/hell-gate-bridge:latest

# Object storage for uploaded GTFS zips. The bucket name appears here, in
# dev/garage/init.sh's default and in each app's S3_BUCKET; keep them together.
# The key is fixed rather than generated so the apps can be configured before
# the store exists: garage-init imports exactly this pair. Garage enforces its
# own key format on import - GK plus 24 hex, and 64 hex for the secret - so
# these are not arbitrary strings.
S3_BUCKET=gtfs-feeds
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
